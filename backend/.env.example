# Bu faylı ".env" adı ilə kopyalayın və dəyərləri dəyişin: cp .env.example .env

# Domen alınana qədər ":80" saxlayın (server IP ilə, HTTP üzərindən işləyir).
# Domen alandan sonra onu yazın (məs. api.saytim.az) - Caddy HTTPS sertifikatını
# Let's Encrypt-dən avtomatik alacaq və yeniləyəcək.
SITE_ADDRESS=:80

POSTGRES_DB=imtahan
POSTGRES_USER=imtahan
# Uzun, təsadüfi parol: openssl rand -base64 24
POSTGRES_PASSWORD=change-me

# JWT imza açarı, ən azı 32 simvol: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Müəllim (admin) girişinin parolu - həm tətbiqdə, həm də brauzerdə (/admin)
IMTAHAN_ADMIN_PASSWORD=change-me
